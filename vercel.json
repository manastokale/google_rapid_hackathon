{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,backend/.venv/**,backend/tests/**,**/__pycache__/**,.pytest_cache/**,data/__pycache__/**,data/generate_seed_data.py,data/load_to_bigquery.py,data/schemas/**,scripts/**,sql/**,*.md,docker-compose.yml,**/Dockerfile}"
    }
  }
}
