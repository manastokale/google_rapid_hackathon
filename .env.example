# Google / Gemini
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# BigQuery
USE_BIGQUERY=false
BQ_PROJECT_ID=
BQ_RAW_DATASET=margintrust
BQ_ANALYTICS_DATASET=margintrust_analytics
BIGQUERY_DATASET=margintrust
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel/serverless alternative to GOOGLE_APPLICATION_CREDENTIALS:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Fivetran MCP
FIVETRAN_MCP_MODE=mock
# When switching to real Fivetran:
# FIVETRAN_MCP_MODE=real
# FIVETRAN_API_KEY=your-key
# FIVETRAN_API_SECRET=your-secret

# App
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
